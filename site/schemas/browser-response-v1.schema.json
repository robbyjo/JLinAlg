{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JLinAlg human-attested browser response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "prompt_sha256", "provider", "model", "url", "submitted_at", "received_at", "exact_prompt_submitted", "disclosure_approved", "no_patient_data", "response", "references", "decision", "rationale"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 200},
    "model": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Displayed label only; use not_disclosed if unknown. Not authenticated model identity."},
    "url": {"$ref": "#/$defs/cleanUrl"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "exact_prompt_submitted": {"const": true},
    "disclosure_approved": {"const": true},
    "no_patient_data": {"const": true},
    "response": {"type": "string", "minLength": 1, "maxLength": 250000},
    "references": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["title", "url"],
      "properties": {"title": {"type": "string", "minLength": 1}, "url": {"$ref": "#/$defs/cleanUrl"}}
    }},
    "decision": {"enum": ["pending_review", "accepted_for_revision", "rejected"]},
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {"cleanUrl": {"type": "string", "pattern": "^https://[^/?#@]+(/[^?#]*)?$"}},
  "description": "Fill a COPY of the generated response-template.yaml outside the frozen packet. The template deliberately has false/blank attestations and is not importable unchanged. Native validation additionally verifies packet/response hashes, request identity, policy, named human importer, timestamp ordering and size limits. Import does not execute code, approve science or apply manuscript edits."
}
